---
import { SITE_NAME, SITE_URL, CONTACT_EMAIL, FOUNDER_NAME } from '../config';

export interface Props {
  type: string;
  data?: Record<string, any>;
}

const { type, data = {} } = Astro.props;

const schemas: Record<string, object> = {
  localBusiness: {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    'name': SITE_NAME,
    'description': 'AI consultant UK providing practical AI consulting services for SMEs. AI readiness audits, strategy roadmaps, and implementation.',
    'url': SITE_URL,
    'email': CONTACT_EMAIL,
    'priceRange': '\u00a3\u00a3',
    'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
    'founder': { '@type': 'Person', 'name': FOUNDER_NAME, 'jobTitle': 'Technology Architect & AI Consultant' },
    'address': { '@type': 'PostalAddress', 'addressCountry': 'GB' },
    'knowsAbout': ['AI implementation', 'AI strategy', 'AI readiness audit', 'AI automation', 'fractional AI officer', 'AI transformation'],
  },
  organization: {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    'name': SITE_NAME,
    'url': SITE_URL,
    'email': CONTACT_EMAIL,
    'founder': { '@type': 'Person', 'name': FOUNDER_NAME },
    'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
    'description': 'Practical AI consulting for UK SMEs. AI readiness audits, strategy roadmaps, and implementation services.',
  },
  website: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': SITE_NAME,
    'url': SITE_URL,
    'potentialAction': {
      '@type': 'SearchAction',
      'target': `${SITE_URL}/blog?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  faqPage: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': (data.questions || []).map((q: any) => ({
      '@type': 'Question',
      'name': q.question,
      'acceptedAnswer': { '@type': 'Answer', 'text': q.answer },
    })),
  },
  breadcrumb: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': (data.items || []).map((item: any, i: number) => ({
      '@type': 'ListItem',
      'position': i + 1,
      'name': item.name,
      'item': item.url,
    })),
  },
  service: {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': data.name || 'AI Consulting Services for UK SMEs',
    'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME },
    'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
    'description': data.description || 'AI consulting services including AI readiness audits, strategy roadmaps, implementation, fractional CAIO, and training workshops for UK SMEs.',
    ...(data.offers ? { 'hasOfferCatalog': { '@type': 'OfferCatalog', 'name': 'AI Consulting Services', 'itemListElement': data.offers } } : {}),
  },
  person: {
    '@context': 'https://schema.org',
    '@type': 'Person',
    'name': FOUNDER_NAME,
    'jobTitle': 'Chief Technology Officer & AI Consultant',
    'worksFor': { '@type': 'Organization', 'name': SITE_NAME },
    'description': 'AI advisor and consultant for UK SMEs. Former CTO at Fabric Fintech, acquired by Aviva. 27+ years in technology leadership. Delivered Aviva\'s first customer-facing generative AI product .',
    'knowsAbout': ['AI implementation', 'AI strategy', 'technology leadership', 'AI transformation', 'enterprise AI', 'SME consulting', 'generative AI', 'AI governance', 'team leadership'],
    'nationality': 'British',
    'address': { '@type': 'PostalAddress', 'addressCountry': 'GB' },
    'award': ['Tech of the Year 2024 (UK Fintech Awards)', 'Pension Innovation Award 2024 (MoneyFacts)'],
  },
  howTo: {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    'name': 'How to Implement AI in a Small Business',
    'description': 'A 4-step methodology for AI adoption in UK SMEs: Discover, Diagnose, Design, Deliver.',
    'step': [
      { '@type': 'HowToStep', 'position': 1, 'name': 'Discover', 'text': 'We learn your business, operations, tech stack, team, and goals. We conduct interviews with key staff, audit your current tools and workflows, and understand your data landscape.' },
      { '@type': 'HowToStep', 'position': 2, 'name': 'Diagnose', 'text': 'We identify where AI creates real value and where it doesn\'t. We map workflows to AI opportunities, estimate ROI for each, assess team readiness, and flag compliance considerations.' },
      { '@type': 'HowToStep', 'position': 3, 'name': 'Design', 'text': 'We architect the solution: which AI tools to use, how they integrate with your existing tech stack, what the rollout plan looks like, and what training your team needs.' },
      { '@type': 'HowToStep', 'position': 4, 'name': 'Deliver', 'text': 'We implement the AI systems, integrate them with your tools, train your team, and provide 30 days of post-launch support. Full documentation and handover.' },
    ],
    'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME },
  },
  blog: {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    'name': `${SITE_NAME} Blog`,
    'description': 'Practical guides on AI adoption, AI automation, and AI strategy for UK SMEs.',
    'url': `${SITE_URL}/blog`,
    'publisher': { '@type': 'Organization', 'name': SITE_NAME },
  },
  contactPage: {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    'name': `Contact ${SITE_NAME}`,
    'description': `Book a free 30-minute AI discovery call with ${SITE_NAME}, an AI consultant for UK SMEs.`,
    'url': `${SITE_URL}/contact`,
    'mainEntity': {
      '@type': 'LocalBusiness',
      'name': SITE_NAME,
      'email': CONTACT_EMAIL,
      'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
    },
  },
};

const schema = schemas[type];
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}