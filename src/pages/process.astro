---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTASection from '../components/CTASection.astro';
import { SITE_NAME, SITE_URL } from '../config';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = `AI Diagnose Consulting | How It Works | ${SITE_NAME}`;
const description = 'Our 4-step AI methodology: Discover, Diagnose, Design, Deliver. A proven process for AI implementation in UK SMEs. Fixed-price, jargon-free, outcome-focused.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE_URL },
    { '@type': 'ListItem', 'position': 2, 'name': 'How It Works', 'item': `${SITE_URL}/process` },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'How to Implement AI in a Small Business',
  'description': 'A 4-step methodology for AI adoption in UK SMEs: Discover, Diagnose, Design, Deliver.',
  'step': [
    { '@type': 'HowToStep', 'position': 1, 'name': 'Discover', 'text': 'We learn your business, operations, tech stack, team, and goals. We conduct interviews with key staff, audit your current tools and workflows, and understand your data landscape.' },
    { '@type': 'HowToStep', 'position': 2, 'name': 'Diagnose', 'text': 'We identify where AI creates real value and where it doesn\'t. We map workflows to AI opportunities, estimate ROI for each, assess team readiness, and flag compliance considerations.' },
    { '@type': 'HowToStep', 'position': 3, 'name': 'Design', 'text': 'We architect the solution: which AI tools to use, how they integrate with your existing tech stack, what the rollout plan looks like, and what training your team needs.' },
    { '@type': 'HowToStep', 'position': 4, 'name': 'Deliver', 'text': 'We implement the AI systems, integrate them with your tools, train your team, and provide 30 days of post-launch support. Full documentation and handover.' },
  ],
  'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME },
};
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema, howToSchema]}>
  <section class="page-header">
    <div class="container">
      <h1>How AI Implementation Works, Step by Step</h1>
      <p>Our process has four steps: Discover, Diagnose, Design, and Deliver. Most engagements take 4-12 weeks from start to finish. You can stop at any stage with no obligation to continue.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'How It Works'}]} />

  <!-- PROCESS OVERVIEW -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">The 4D Methodology</h2>
      <p class="section-subtitle reveal">Discover, Diagnose, Design, Deliver. A methodology refined through enterprise AI projects, adapted for SME timelines and budgets.</p>
      <ProcessSteps />
    </div>
  </section>

  <!-- DETAILED STEPS -->
  <section class="section bg-grey">
    <div class="container">
      <!-- Step 1: Discover -->
      <div class="split-content reveal" style="margin-bottom:64px;">
        <div class="split-visual" role="img" aria-label="Discovery phase: learning about the client's business operations">
          <img src="/images/process-discover.jpg" alt="AI consultant discovering business operations during discovery phase" width="1200" height="800" />
        </div>
        <div>
          <span class="eyebrow">Step 1, Week 1</span>
          <h2>Discover: We Learn Your Business</h2>
          <p>Every engagement starts with understanding your business, not our technology. We don't walk in with a template, we build the picture from scratch.</p>
          <ul style="list-style:none;margin-top:16px;">
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Interviews with leadership and key team members</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Discover of your current tech stack and software ecosystem</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Workflow mapping, how work actually gets done (not how it's documented)</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Data landscape review, what data you have, where it lives, quality</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Team readiness assessment, skills, attitudes, concerns</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Business goals and constraints, what success looks like for you</li>
          </ul>
          <p style="margin-top:16px;font-size:0.9rem;color:var(--grey-500);"><strong>Output:</strong> A baseline understanding document that everything else builds on. You review and approve it before we move to diagnosis.</p>
        </div>
      </div>

      <!-- Step 2: Diagnose -->
      <div class="split-content reveal" style="margin-bottom:64px;">
        <div>
          <span class="eyebrow">Step 2, Weeks 1-2</span>
          <h2>Diagnose: We Find Real Opportunities</h2>
          <p>Using what we learned in Discover, we map your workflows against AI capabilities to find where the real value is, and where it isn't.</p>
          <ul style="list-style:none;margin-top:16px;">
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Workflow-by-workflow AI opportunity assessment</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> ROI estimates for each opportunity (time saved, cost reduced, revenue gained)</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Difficulty and feasibility scoring, what's easy, what's hard, what's not worth it</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Quick wins identified (things you can act on in days, not months)</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Compliance and data risk assessment for each opportunity</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Honest "don't bother" list, things that sound good but won't deliver</li>
          </ul>
          <p style="margin-top:16px;font-size:0.9rem;color:var(--grey-500);"><strong>Output:</strong> A prioritised AI Opportunity Report with ROI estimates. This is the core deliverable of the <a href="/services#audit">AI Opportunity Discover</a>.</p>
        </div>
        <div class="split-visual" role="img" aria-label="Diagnosis phase: analysing AI opportunities and ROI">
          <img src="/images/services-analytics.jpg" alt="AI diagnosis and analytics for UK SME opportunity assessment" width="1200" height="800" />
        </div>
      </div>

      <!-- Step 3: Design -->
      <div class="split-content reveal" style="margin-bottom:64px;">
        <div class="split-visual" role="img" aria-label="Design phase: architecting the AI solution and integration plan">
          <img src="/images/process-design.jpg" alt="AI solution architecture and integration design for UK SMEs" width="1200" height="800" />
        </div>
        <div>
          <span class="eyebrow">Step 3, Weeks 2-4</span>
          <h2>Design: We Architect the Solution</h2>
          <p>For opportunities worth pursuing, we design the full solution: which tools, how they connect, and how we roll them out without disrupting your business.</p>
          <ul style="list-style:none;margin-top:16px;">
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Tool selection and configuration tailored to your workflows</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Design vs buy analysis for each component</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Integration architecture, how AI connects to your existing tools</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Data flow design, where data moves, how it's protected</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> 90-day implementation roadmap with clear milestones</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Team training plan, what skills, who needs them, when</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Success metrics, how we'll measure impact</li>
          </ul>
          <p style="margin-top:16px;font-size:0.9rem;color:var(--grey-500);"><strong>Output:</strong> A complete AI Diagnose &amp; Roadmap document. This is the core deliverable of the <a href="/services#strategy">Diagnose engagement</a>.</p>
        </div>
      </div>

      <!-- Step 4: Deliver -->
      <div class="split-content reveal">
        <div>
          <span class="eyebrow">Step 4, Weeks 4-12</span>
          <h2>Deliver: We Design, Integrate, Train</h2>
          <p>This is where most consultants stop. We don't. We implement the plan, connect everything to your tools, train your people, and stay for 30 days after launch.</p>
          <ul style="list-style:none;margin-top:16px;">
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> AI system configuration and setup</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> API integrations with your existing tools (CRM, accounting, comms, etc.)</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Workflow automation setup</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Security and compliance implementation (GDPR, data residency)</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Team training sessions (group + 1:1)</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Full documentation, system docs, user guides, troubleshooting</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> 30-day post-launch support, we're there when things go live</li>
            <li style="padding:8px 0;display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--teal-dark);font-weight:700;flex-shrink:0;">&#x2713;</span> Performance monitoring setup and handover</li>
          </ul>
          <p style="margin-top:16px;font-size:0.9rem;color:var(--grey-500);"><strong>Output:</strong> Working AI systems, trained team, full documentation, and self-sufficiency. This is the <a href="/services#implementation">Implementation engagement</a>.</p>
        </div>
        <div class="split-visual" role="img" aria-label="Delivery phase: implementing and integrating AI systems with team training">
          <img src="/images/process-deliver.jpg" alt="AI implementation delivery and team training for UK SMEs" width="1200" height="1800" />
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">Typical Timeline</h2>
      <p class="section-subtitle reveal">From first call to working AI systems. Every project is different, but here's what the process typically looks like.</p>
      <div class="cards-grid cards-4">
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="chat" /></div>
          <h3>Day 0</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">Free 30-min discovery call. We discuss your business and whether AI makes sense.</p>
        </div>
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="search" /></div>
          <h3>Weeks 1-2</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">AI Opportunity Discover. Discover + Diagnose. You get your prioritised opportunity report.</p>
        </div>
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="map" /></div>
          <h3>Weeks 3-5</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">Diagnose &amp; Roadmap. Design phase. You get your 90-day implementation plan.</p>
        </div>
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="wrench" /></div>
          <h3>Weeks 6-12</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">Implementation. Deliver phase. Working AI systems, trained team, 30-day support.</p>
        </div>
      </div>
      <p class="text-center mt-3 reveal" style="color:var(--grey-500);font-size:0.9rem;">You can stop at any stage. The audit is self-contained. The strategy is self-contained. No lock-in.</p>
    </div>
  </section>

  <!-- WHY THIS PROCESS WORKS -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">Why This Process Works for SMEs</h2>
      <p class="section-subtitle reveal">It's designed around the realities of running a 10-250 person business, not enterprise workflows.</p>
      <div class="cards-grid cards-3">
        <div class="card reveal">
          <div class="card-icon"><Icon name="shield" /></div>
          <h3>De-risks Investment</h3>
          <p>The &pound;750 audit tells you whether AI is worth it before you spend &pound;15,000. You make informed decisions at each stage, not blind leaps.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="compass" /></div>
          <h3>Stoppable at Any Point</h3>
          <p>Each phase delivers standalone value. If the audit shows AI isn't right for you yet, you've spent &pound;750, not &pound;30,000. No pressure to continue.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="graduation" /></div>
          <h3>Built for Real Teams</h3>
          <p>Your team isn't a data science department, and that's fine. The process works with the skills you have and builds the skills you need.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to Start with Discover?"
    text="Book a free 30-minute call. We'll talk through your business and decide together whether the audit is the right starting point."
  />
</BaseLayout>