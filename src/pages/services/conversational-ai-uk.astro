---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { SITE_NAME, SITE_URL } from '../../config';

const title = `Conversational AI UK | AI Chatbots & Assistants | ${SITE_NAME}`;
const description = 'Conversational AI UK for SMEs. AI chatbots and assistants that handle queries, book meetings, and process requests. Customer support, internal helpdesk, sales qualification. From GBP 8,000. Book a free call.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE_URL },
    { '@type': 'ListItem', 'position': 2, 'name': 'Services', 'item': `${SITE_URL}/services` },
    { '@type': 'ListItem', 'position': 3, 'name': 'Conversational AI UK', 'item': `${SITE_URL}/services/conversational-ai-uk` },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Conversational AI UK',
  'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME },
  'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
  'description': 'Conversational AI UK service for SMEs. AI chatbots and assistants that handle customer queries, book meetings, process requests, and qualify leads. Customer support, internal helpdesk, sales qualification, and appointment booking. Fixed-price from GBP 8,000.',
  'offers': {
    '@type': 'Offer',
    'priceRange': '\u00a38,000-\u00a325,000',
    'priceCurrency': 'GBP',
    'description': 'Fixed-price conversational AI implementation for UK SMEs, 4-8 weeks duration.',
  },
};

const faqs = [
  { question: 'How much does conversational AI UK cost?', answer: 'Our conversational AI UK implementations start at GBP 8,000 for a single-use-case AI assistant and range up to GBP 25,000 for comprehensive, multi-channel AI assistants integrated with your CRM, booking, and support systems. Every engagement is fixed-price. The cost depends on the number of use cases, the complexity of integrations, the channels supported (web, WhatsApp, email, SMS), and the level of custom training required.' },
  { question: 'How is conversational AI different from a traditional chatbot?', answer: 'Traditional chatbots follow rigid decision trees: if the user says X, respond with Y. They break the moment a user phrases something differently or asks an unexpected question. Conversational AI uses large language models to understand intent, handle variation, and generate natural responses. It can answer questions it was not explicitly programmed for, handle complex multi-turn conversations, and actually help users rather than frustrating them. This is why conversational AI delivers real business value where traditional chatbots failed.' },
  { question: 'Should we build a custom AI assistant or use an existing platform?', answer: 'It depends on your use case. For standard customer support or FAQ answering, existing platforms may be sufficient and faster to deploy. For use cases that require deep integration with your systems, custom knowledge, or complex workflows, a custom-built assistant delivers better results. We assess your specific requirements and recommend the right approach. Our build-vs-buy analysis, included in every engagement, gives you a clear recommendation based on your specific needs.' },
  { question: 'How long does it take to implement conversational AI?', answer: 'Typically 4 to 8 weeks. Single-use-case assistants (e.g. a customer support chatbot for your website) take 4-6 weeks. Multi-channel assistants with CRM integration and multiple use cases take 6-8 weeks. Every implementation includes 30 days of post-launch support to monitor performance, refine responses, and ensure your team is comfortable managing the assistant. We do not consider the job done until the assistant is performing well and your team can manage it independently.' },
  { question: 'Can conversational AI integrate with our existing systems?', answer: 'Yes. We integrate AI assistants with your CRM, booking systems, helpdesk, knowledge base, accounting software, and any other system with an API. The assistant can look up customer records, check availability, create tickets, process bookings, and pull information from your documents. This is what turns a chatbot into a genuine AI assistant that handles real business tasks, not just answers questions. Integration is included in every engagement.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((q) => ({
    '@type': 'Question',
    'name': q.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': q.answer },
  })),
};
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema, serviceSchema, faqSchema]}>
  <section class="page-header">
    <div class="container">
      <h1>Conversational AI UK: AI Chatbots and Assistants for Business</h1>
      <p>Conversational AI UK for SMEs with 10-250 employees. Not just chatbots. AI assistants that handle queries, book meetings, process requests, and qualify leads. Integrated with your existing systems. From &pound;8,000. 30-day post-launch support included.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Services',href:'/services'},{name:'Conversational AI UK'}]} />

  <!-- INTRO -->
  <section class="section">
    <div class="container">
      <div class="prose" style="max-width:800px;">
        <p style="font-size:1.1rem;line-height:1.7;">Conversational AI UK has moved far beyond the frustrating chatbots of a few years ago. Today's AI assistants understand natural language, handle complex queries, book meetings, process requests, and integrate with your business systems. They do real work, not just deflect it.</p>
        <p style="line-height:1.7;">The old chatbots failed because they were rule-based: if the user says X, respond with Y. They broke the moment anyone phrased something differently. Modern conversational AI is different. Powered by large language models, it understands intent, handles variation, and generates natural, helpful responses. It can answer questions it was never explicitly programmed for, conduct multi-turn conversations, and actually solve problems for your customers and team.</p>
        <p style="line-height:1.7;">As an <a href="/">AI consulting UK</a> practice, we have implemented conversational AI for businesses across customer support, internal helpdesk, sales, and operations. The results are consistent: faster response times, reduced manual workload, happier customers, and teams freed from repetitive queries to focus on higher-value work. The businesses that deploy conversational AI well see customer satisfaction scores rise, response times drop from hours to seconds, and team productivity increase by 20-40% as the AI handles the repetitive work that previously consumed their day. The key is implementation done right: training the assistant on accurate knowledge, integrating it with your real systems, and supporting it after launch. Read our guide to <a href="/blog">conversational AI for UK businesses</a> for real-world examples and use cases.</p>
      </div>
    </div>
  </section>

  <!-- WHAT CONVERSATIONAL AI MEANS -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">What Conversational AI Means Today</h2>
      <p class="section-subtitle reveal">Not just chatbots. AI assistants that handle real business tasks.</p>
      <div class="cards-grid cards-2">
        <div class="card reveal">
          <div class="card-icon"><Icon name="chat" /></div>
          <h3>Answer Queries</h3>
          <p>An AI assistant trained on your business knowledge can answer customer questions instantly, 24/7. Product details, pricing, policies, availability, status updates. No more making customers wait for an email response or sit on hold. The assistant handles the repetitive queries that consume your team's time, leaving complex cases for human handling.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="calendar" /></div>
          <h3>Book Meetings</h3>
          <p>The assistant does not just answer questions. It takes action. It can check calendar availability, book appointments, send confirmations, and handle rescheduling. No more back-and-forth emails to find a suitable time. Customers and prospects get instant booking, and your team's calendars are managed automatically.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="settings" /></div>
          <h3>Process Requests</h3>
          <p>The assistant can process real requests: order status checks, returns initiation, account updates, quote requests, complaint logging. It connects to your CRM, order management, and support systems through APIs, so it does not just talk about your business. It interacts with it. This is what separates an AI assistant from a chatbot.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="compass" /></div>
          <h3>Qualify & Route</h3>
          <p>The assistant qualifies leads and routes them to the right person. It asks the right questions, scores the lead, and sends it to sales, support, or account management based on the response. No more manual triage. Your team receives pre-qualified enquiries with context, so they can focus on conversion rather than sorting.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">Conversational AI UK Use Cases</h2>
      <p class="section-subtitle reveal">The most impactful applications of conversational AI for UK SMEs.</p>
      <div class="cards-grid cards-2">
        <div class="card reveal">
          <div class="card-icon"><Icon name="email" /></div>
          <h3>Customer Support</h3>
          <p>An AI assistant on your website, WhatsApp, or email that answers customer questions instantly. Handles 60-80% of routine enquiries automatically, routes complex cases to your team with full context. Typical result: response times drop from hours to seconds, customer satisfaction rises, and your support team handles more volume without hiring. The assistant is trained on your knowledge base, policies, and FAQs, so answers are accurate and on-brand.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="users" /></div>
          <h3>Internal Helpdesk</h3>
          <p>An AI assistant for your team that answers internal questions. HR policies, IT support, process guidance, document location. Instead of your team emailing around for answers, they ask the assistant and get instant responses. Typical result: 50% reduction in internal queries, faster onboarding for new starters, and consistent answers rather than tribal knowledge. The assistant is trained on your internal documents and continuously updated as policies change.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="target" /></div>
          <h3>Sales Qualification</h3>
          <p>An AI assistant on your website that engages visitors, qualifies leads, and books meetings with your sales team. It asks qualifying questions, scores the lead, and routes hot prospects directly to sales. Typical result: 30-50% more qualified meetings booked, faster response to enquiries, and your sales team focuses on selling rather than chasing. The assistant works 24/7, so you never miss a lead outside business hours.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="calendar" /></div>
          <h3>Appointment Booking</h3>
          <p>An AI assistant that handles appointment booking end-to-end. Customers ask about availability, the assistant checks your calendar, books the slot, sends confirmations, and handles rescheduling. Works for clinics, salons, consultancies, trades, and any business that books appointments. Typical result: 40% reduction in booking-related admin, fewer no-shows with automated reminders, and bookings accepted 24/7 even when your team is unavailable.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BUILD VS BUY -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">Build vs Buy: Choosing the Right Approach</h2>
      <p class="section-subtitle reveal">The right answer depends on your use case, budget, and timeline. We help you decide.</p>
      <div class="cards-grid cards-2">
        <div class="card reveal">
          <h3>When to Buy Off-the-Shelf</h3>
          <ul style="margin-top:12px;font-size:0.95rem;line-height:1.8;">
            <li>Your use case is standard (FAQ answering, basic support)</li>
            <li>You need to launch quickly (days, not weeks)</li>
            <li>Your budget is limited (under &pound;5,000)</li>
            <li>You do not need deep integration with custom systems</li>
            <li>Your knowledge base is well-structured and documented</li>
            <li>You want to test the concept before investing more</li>
          </ul>
          <p style="margin-top:12px;font-size:0.9rem;">Platforms like Intercom Fin, Zendesk AI, and Tidio offer capable conversational AI. We help you select, configure, and deploy the right one for your needs.</p>
        </div>
        <div class="card reveal" style="border:2px solid var(--teal);background:rgba(0,196,167,0.04);">
          <h3>When to Build Custom</h3>
          <ul style="margin-top:12px;font-size:0.95rem;line-height:1.8;">
            <li>You need deep integration with CRM, booking, or custom systems</li>
            <li>Your use case involves complex, multi-step workflows</li>
            <li>You need the assistant to take actions, not just answer questions</li>
            <li>You have specific brand voice and tone requirements</li>
            <li>You need multi-channel support (web, WhatsApp, email, SMS)</li>
            <li>You want full control over data, hosting, and compliance</li>
          </ul>
          <p style="margin-top:12px;font-size:0.9rem;">Custom-built assistants use LLM APIs (OpenAI, Anthropic) with your knowledge base, integrations, and business logic. You own everything. We design, build, and deploy it.</p>
        </div>
      </div>
      <p style="margin-top:24px;line-height:1.7;max-width:800px;">In most cases, the answer is a hybrid: use an existing platform for standard queries, then layer custom integrations and workflows on top. This gives you the speed of established platforms with the power of custom. Our build-vs-buy analysis, included in every engagement, gives you a clear recommendation based on your specific needs, not a generic answer. The wrong choice here is expensive: using a platform when you should build means hitting limitations within months, while building when a subscription could have handled it means spending &pound;15,000+ unnecessarily. We help you get it right the first time.</p>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id="pricing">
    <div class="container">
      <h2 class="section-title reveal">Conversational AI UK Pricing</h2>
      <p class="section-subtitle reveal">Fixed-price. You know the total cost before we start. No open-ended billing.</p>
      <div class="cards-grid cards-3">
        <div class="pricing-card reveal">
          <div class="pricing-tier">Single Use Case</div>
          <h3>AI Assistant Starter</h3>
          <div class="pricing-price">&pound;8,000-&pound;12,000</div>
          <div class="pricing-duration">4-6 weeks</div>
          <ul class="pricing-features">
            <li>One AI assistant for one channel</li>
            <li>Trained on your knowledge base</li>
            <li>Integration with 1-2 existing systems</li>
            <li>Website or WhatsApp deployment</li>
            <li>Team training and documentation</li>
            <li>30-day post-launch support</li>
            <li>GDPR compliance included</li>
          </ul>
          <a href="/contact" class="btn btn-outline">Get a Quote</a>
        </div>
        <div class="pricing-card featured reveal">
          <div class="pricing-badge">Most Popular</div>
          <div class="pricing-tier">Multi-Use Case</div>
          <h3>AI Assistant Complete</h3>
          <div class="pricing-price">&pound;12,000-&pound;18,000</div>
          <div class="pricing-duration">6-8 weeks</div>
          <ul class="pricing-features">
            <li>AI assistant with 2-3 use cases</li>
            <li>Multi-channel (web + WhatsApp or email)</li>
            <li>Integration with CRM, booking, and support</li>
            <li>Lead qualification and routing</li>
            <li>Custom knowledge base training</li>
            <li>Performance analytics dashboard</li>
            <li>Team training and full documentation</li>
            <li>30-day post-launch support</li>
          </ul>
          <a href="/contact" class="btn btn-primary">Get a Quote</a>
        </div>
        <div class="pricing-card reveal">
          <div class="pricing-tier">Full Organisation</div>
          <h3>AI Assistant Enterprise</h3>
          <div class="pricing-price">&pound;18,000-&pound;25,000</div>
          <div class="pricing-duration">8-10 weeks</div>
          <ul class="pricing-features">
            <li>Comprehensive multi-use-case assistant</li>
            <li>All channels (web, WhatsApp, email, SMS)</li>
            <li>Full system integration (5+ systems)</li>
            <li>Custom workflow automation</li>
            <li>Advanced analytics and reporting</li>
            <li>Brand voice and tone customisation</li>
            <li>Comprehensive training programme</li>
            <li>30-day post-launch support</li>
          </ul>
          <a href="/contact" class="btn btn-outline">Get a Quote</a>
        </div>
      </div>
      <p class="text-center mt-3 reveal" style="color:var(--grey-500);font-size:0.9rem;">All prices are fixed and agreed before work starts. <a href="/blog">Read our guide to affordable AI consulting UK pricing</a>.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">How Your Conversational AI UK Engagement Works</h2>
      <p class="section-subtitle reveal">A structured process that delivers a working AI assistant, not a demo.</p>
      <div class="cards-grid cards-4">
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="search" /></div>
          <h3>1. Discover</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">We map your use cases, identify the right build-vs-buy approach, and plan the integrations with your existing systems.</p>
        </div>
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="wrench" /></div>
          <h3>2. Build</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">We build the AI assistant, train it on your knowledge base, integrate it with your systems, and test thoroughly with real scenarios.</p>
        </div>
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="graduation" /></div>
          <h3>3. Launch</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">We deploy the assistant, train your team on managing and improving it, and launch to your customers or internal users.</p>
        </div>
        <div class="card reveal" style="text-align:center;">
          <div class="card-icon" style="margin:0 auto 16px;"><Icon name="lifebuoy" /></div>
          <h3>4. Support</h3>
          <p style="font-size:0.9rem;color:var(--grey-500);">We stay for 30 days post-launch. We monitor performance, refine responses, fix issues, and ensure your team is self-sufficient. The assistant gets better every week as we tune it based on real conversations, and your team learns how to manage and improve it independently. We do not consider the job done until the assistant is performing well and your team can run it without us.</p>
        </div>
      </div>
      <p class="text-center mt-3 reveal"><a href="/process">See our full methodology</a></p>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">Is Conversational AI UK Right for You?</h2>
      <p class="section-subtitle reveal">This service is designed for UK businesses that want to automate customer and internal interactions with AI.</p>
      <div class="cards-grid cards-2">
        <div class="card reveal">
          <div class="card-icon"><Icon name="check" /></div>
          <h3>This Is Right for You If</h3>
          <ul style="margin-top:12px;font-size:0.95rem;line-height:1.8;">
            <li>Your business has 10-250 employees</li>
            <li>Your team spends significant time on repetitive queries</li>
            <li>You want 24/7 customer or lead engagement</li>
            <li>You need to reduce response times without hiring</li>
            <li>You have a knowledge base the AI can be trained on</li>
            <li>You want an assistant that takes action, not just answers questions</li>
          </ul>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="target" /></div>
          <h3>You May Not Need This If</h3>
          <ul style="margin-top:12px;font-size:0.95rem;line-height:1.8;">
            <li>You have not yet assessed your AI readiness. Start with the <a href="/services/ai-readiness-audit-uk">AI readiness audit UK</a>.</li>
            <li>You need a broader AI strategy first. See our <a href="/services/ai-strategy-uk">AI strategy UK</a> service.</li>
            <li>You need general AI implementation across multiple areas. See our <a href="/services/ai-implementation-uk">AI implementation UK</a> service.</li>
            <li>You need workflow automation rather than conversational AI. See our <a href="/services/ai-automation-uk">AI automation UK</a> service.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-grey" id="faq">
    <div class="container">
      <h2 class="section-title reveal">Conversational AI UK FAQs</h2>
      <p class="section-subtitle reveal">Common questions about our conversational AI UK service.</p>
      <FAQ items={faqs} />
    </div>
  </section>

  <CTASection
    title="Ready to Deploy an AI Assistant for Your Business?"
    text="Book a free 30-minute discovery call. We will talk through your use cases, your existing systems, and whether conversational AI is the right next step for your business."
    secondaryCtaText="View All Services &amp; Pricing"
    secondaryCtaHref="/services"
  />
</BaseLayout>