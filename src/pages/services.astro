---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { SITE_NAME, SITE_URL } from '../config';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = `AI Consulting Services UK | Pricing & Services | ${SITE_NAME}`;
const description = 'AI consulting services UK pricing guide for SMEs. Fixed-price AI readiness audits from \u00a3750, strategy roadmaps from \u00a35,000, implementation from \u00a38,000, automation from \u00a33,000. Fractional CAIO available.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE_URL },
    { '@type': 'ListItem', 'position': 2, 'name': 'Services & Pricing', 'item': `${SITE_URL}/services` },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'AI Consulting Services for UK SMEs',
  'provider': { '@type': 'LocalBusiness', 'name': SITE_NAME },
  'areaServed': { '@type': 'Country', 'name': 'United Kingdom' },
  'description': 'AI consulting services including AI readiness audits, strategy roadmaps, implementation, fractional CAIO, and training workshops for UK SMEs.',
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'AI Consulting Services',
    'itemListElement': [
      { '@type': 'Offer', 'name': 'AI Opportunity Audit', 'priceRange': '\u00a3750-\u00a32,500', 'priceCurrency': 'GBP', 'description': 'Structured assessment of operations, tech, and team readiness with prioritised AI opportunity report and ROI estimates.' },
      { '@type': 'Offer', 'name': 'AI Strategy & Roadmap', 'priceRange': '\u00a35,000-\u00a315,000', 'priceCurrency': 'GBP', 'description': 'Full workflow mapping, build vs buy recommendations, integration architecture, 90-day implementation roadmap, and team training plan.' },
      { '@type': 'Offer', 'name': 'AI Implementation', 'priceRange': '\u00a38,000-\u00a330,000+', 'priceCurrency': 'GBP', 'description': 'Configured AI systems, API integrations, team training, documentation, and 30-day post-launch support.' },
      { '@type': 'Offer', 'name': 'Fractional CAIO', 'priceRange': '\u00a32,000-\u00a35,000/month', 'priceCurrency': 'GBP', 'description': 'Part-time AI leadership providing ongoing strategic direction, vendor management, and team mentoring.' },
      { '@type': 'Offer', 'name': 'AI Training Workshops', 'priceRange': '\u00a31,500', 'priceCurrency': 'GBP', 'description': "Half-day or full-day hands-on workshops to build your team's AI literacy and practical skills." },
    ],
  },
};

const pricingFaqs = [
  { question: 'Why are your prices fixed and not day-rate?', answer: '76% of UK businesses see high costs as a significant barrier to AI adoption. Day-rate consulting creates a perverse incentive: the longer it takes, the more the consultant earns. Fixed-price engagements align our interests with yours: we are rewarded for efficiency, not for dragging things out. You know the total cost before we start.' },
  { question: 'What determines where I fall within a price range?', answer: 'It depends on your business size, the complexity of your operations, the number of departments involved, and the depth of the engagement. The free discovery call helps us understand your needs and give you a precise quote before anything starts. There are no surprise costs.' },
  { question: 'Do we have to do the audit before strategy or implementation?', answer: 'No, but we strongly recommend it. The audit de-risks everything that follows and often saves clients from investing in the wrong areas. If you already have a clear sense of what you need, we can start at the strategy or implementation stage, but the audit findings are incorporated into the early phase of any engagement regardless.' },
  { question: 'Can we get funding or grants for AI consulting?', answer: 'Possibly. There are various UK government and regional initiatives that support AI adoption and digital transformation for SMEs. We can discuss current options during the discovery call and help you identify whether any apply to your situation. Our reports are structured to support funding applications where relevant.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': pricingFaqs.map((q) => ({
    '@type': 'Question',
    'name': q.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': q.answer },
  })),
};
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema, serviceSchema, faqSchema]}>
  <section class="page-header">
    <div class="container">
      <h1>AI Consulting Services UK: Pricing, Services &amp; Process</h1>
      <p>Our AI consulting services UK pricing starts at &pound;750 for a full opportunity audit and ranges up to &pound;30,000+ for complete implementation. Every engagement is fixed-price, you own what we build, and we tell you when AI isn't the right answer.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Services & Pricing'}]} />

  <!-- DEDICATED SERVICE PAGES -->
  <section class="section" id="dedicated-services">
    <div class="container">
      <h2 class="section-title reveal">AI Consulting Services UK: Dedicated Service Pages</h2>
      <p class="section-subtitle reveal">Each core service has a dedicated page with detailed pricing, FAQs, and process. Explore the specific service that matches where you are today.</p>
      <div class="cards-grid cards-3">
        <a href="/services/ai-strategy-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="map" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">AI Strategy UK</h3>
          <p style="font-size:0.9rem;">Complete AI adoption roadmap. Workflow mapping, build-vs-buy, 90-day implementation plan. From &pound;5,000.</p>
        </a>
        <a href="/services/ai-implementation-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="wrench" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">AI Implementation UK</h3>
          <p style="font-size:0.9rem;">We build, integrate, and train your team. Working AI systems with 30-day support. From &pound;8,000.</p>
        </a>
        <a href="/services/ai-automation-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="settings" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">AI Automation UK</h3>
          <p style="font-size:0.9rem;">Workflow automation that saves 10-20 hours per week. Connect your tools with AI. From &pound;3,000.</p>
        </a>
      </div>
      <div class="cards-grid cards-3" style="margin-top:24px;">
        <a href="/services/ai-readiness-audit-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="search" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">AI Readiness Audit UK</h3>
          <p style="font-size:0.9rem;">Structured assessment of data, infrastructure, and team readiness. From &pound;750.</p>
        </a>
        <a href="/services/fractional-caio-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="briefcase" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">Fractional CAIO UK</h3>
          <p style="font-size:0.9rem;">Part-time AI leadership for SMEs. Strategy, governance, and mentoring. From &pound;2,000/month.</p>
        </a>
        <a href="/services/ai-governance-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="shield" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">AI Governance UK</h3>
          <p style="font-size:0.9rem;">AI policy, compliance, and risk management. GDPR, bias testing, audit trails. From &pound;3,000.</p>
        </a>
      </div>
      <div class="cards-grid cards-2" style="margin-top:24px;">
        <a href="/services/ai-training-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="graduation" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">AI Training UK</h3>
          <p style="font-size:0.9rem;">Practical AI workshops for business teams. AI literacy, prompt engineering, tool selection. From &pound;1,500.</p>
        </a>
        <a href="/services/conversational-ai-uk" class="card reveal" style="text-align:center;padding:32px 24px;display:block;">
          <div class="card-icon"><Icon name="chat" /></div>
          <h3 style="font-size:1.15rem;margin-bottom:8px;">Conversational AI UK</h3>
          <p style="font-size:0.9rem;">AI chatbots and assistants for customer support, helpdesk, and sales. From &pound;8,000.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- PRICING TIERS -->
  <section class="section" id="pricing">
    <div class="container">
      <h2 class="section-title reveal">AI Consulting Services UK Pricing: Three Core Engagements</h2>
      <p class="section-subtitle reveal">AI consulting services UK SMEs can afford. Each engagement is self-contained. You can start with the audit and stop there, or continue through strategy to implementation. No lock-in. All pricing is fixed, agreed upfront, with no open-ended billing.</p>
      <div class="cards-grid cards-3">
        <!-- Tier 1: Audit -->
        <div class="pricing-card reveal" id="audit">
          <div class="pricing-tier">Tier 1, Starting Point</div>
          <h3>AI Opportunity Audit</h3>
          <p style="color:var(--grey-500);font-size:0.9rem;margin-bottom:0;">Find out exactly where AI can help your business. Walk-away protection: you keep the report whether you work with us or not.</p>
          <div class="pricing-price">&pound;750-&pound;2,500</div>
          <div class="pricing-duration">1-2 weeks</div>
          <ul class="pricing-features">
            <li>Structured assessment of operations, tech, and team readiness</li>
            <li>Prioritised AI opportunity report</li>
            <li>ROI estimates for top 3-5 opportunities</li>
            <li>Quick-win recommendations you can act on immediately</li>
            <li>Honest assessment of where AI won't help (yet)</li>
            <li>Recommended next steps, no obligation to continue</li>
          </ul>
          <a href="/contact" class="btn btn-outline">Start with an Audit</a>
        </div>

        <!-- Tier 2: Strategy (Featured) -->
        <div class="pricing-card featured reveal" id="strategy">
          <div class="pricing-badge">Most Popular</div>
          <div class="pricing-tier">Tier 2, Planning</div>
          <h3>AI Strategy &amp; Roadmap</h3>
          <p style="color:var(--grey-500);font-size:0.9rem;margin-bottom:0;">A complete plan for AI adoption across your business.</p>
          <div class="pricing-price">&pound;5,000-&pound;15,000</div>
          <div class="pricing-duration">3-5 weeks</div>
          <ul class="pricing-features">
            <li>Full workflow mapping across all departments</li>
            <li>Build vs buy recommendations for each use case</li>
            <li>Integration architecture for your existing tech stack</li>
            <li>90-day implementation roadmap with milestones</li>
            <li>Team training plan and capability roadmap</li>
            <li>Vendor evaluation and shortlisting</li>
            <li>Compliance and data governance framework</li>
          </ul>
          <a href="/contact" class="btn btn-primary">Build Your Strategy</a>
        </div>

        <!-- Tier 3: Implementation -->
        <div class="pricing-card reveal" id="implementation">
          <div class="pricing-tier">Tier 3, Execution</div>
          <h3>AI Implementation</h3>
          <p style="color:var(--grey-500);font-size:0.9rem;margin-bottom:0;">We build it, integrate it, train your team, and support it. AI implementation UK businesses can rely on.</p>
          <div class="pricing-price">&pound;8,000-&pound;30,000+</div>
          <div class="pricing-duration">6-12 weeks</div>
          <ul class="pricing-features">
            <li>AI systems configured and built around your workflows</li>
            <li>API integrations with your existing tools</li>
            <li>Team training and full documentation</li>
            <li>30-day post-launch support included</li>
            <li>Security and compliance implementation</li>
            <li>Performance monitoring setup</li>
            <li>Handover so your team can manage independently</li>
          </ul>
          <a href="/contact" class="btn btn-outline">Discuss Implementation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ADDITIONAL SERVICES -->
  <section class="section bg-grey" id="additional-services">
    <div class="container">
      <h2 class="section-title reveal">Ongoing &amp; Training Services</h2>
      <p class="section-subtitle reveal">Beyond project-based work, we offer flexible ongoing support and team training options.</p>
      <div class="cards-grid cards-2">
        <!-- Fractional CAIO -->
        <div class="card reveal" id="fractional-caio">
          <div class="card-icon"><Icon name="briefcase" /></div>
          <h3>Fractional CAIO (Chief AI Officer)</h3>
          <div class="pricing-price" style="font-size:1.6rem;margin:12px 0;">&pound;2,000-&pound;5,000<span style="font-size:0.85rem;font-weight:500;color:var(--grey-500);"> /month</span></div>
          <div class="pricing-duration" style="margin-bottom:20px;">Ongoing, Flexible commitment</div>
          <p>Not ready for a full-time AI leader? Get experienced AI leadership on a fractional basis. We provide strategic direction, vendor management, team mentoring, and keep your AI initiatives on track, without the &pound;150k+ salary.</p>
          <ul>
            <li>Monthly strategy sessions with leadership</li>
            <li>AI initiative oversight and prioritisation</li>
            <li>Vendor and tool evaluation</li>
            <li>Team mentoring and capability building</li>
            <li>Board-level reporting on AI ROI</li>
            <li>Flexible, scale up or down month to month</li>
          </ul>
          <a href="/contact" class="btn btn-outline mt-2">Enquire about Fractional CAIO</a>
        </div>

        <!-- Training Workshops -->
        <div class="card reveal" id="training">
          <div class="card-icon"><Icon name="graduation" /></div>
          <h3>AI Training Workshops</h3>
          <div class="pricing-price" style="font-size:1.6rem;margin:12px 0;">from &pound;1,500<span style="font-size:0.85rem;font-weight:500;color:var(--grey-500);">, half-day</span></div>
          <div class="pricing-duration" style="margin-bottom:20px;">Half-day or full-day, On-site or remote</div>
          <p>75% of UK businesses say they need AI training and education. Our workshops are practical, hands-on, and tailored to your business, not generic theory. Your team leaves with real skills they can use the next day.</p>
          <ul>
            <li>AI literacy fundamentals (no jargon)</li>
            <li>Hands-on prompt engineering for your tools</li>
            <li>Workflow automation techniques</li>
            <li>AI safety, ethics, and data governance</li>
            <li>Customised to your industry and use cases</li>
            <li>Full-day workshops also available (from &pound;2,500)</li>
          </ul>
          <a href="/contact" class="btn btn-outline mt-2">Book a Workshop</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED DETAIL -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">What's Different About Our Approach</h2>
      <p class="section-subtitle reveal">We're not a report factory. Every engagement delivers something you can actually use. As your AI integration consultant, we focus on outcomes, not slideware.</p>
      <div class="cards-grid cards-4">
        <div class="card reveal">
          <div class="card-icon"><Icon name="chart" /></div>
          <h3>ROI in Every Report</h3>
          <p>Every recommendation includes estimated time saved, cost reduction, or revenue impact. You make decisions based on numbers, not hype.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="wrench" /></div>
          <h3>Your Tech Stack, Enhanced</h3>
          <p>We start with what you already have. No rip-and-replace, no forcing you onto a platform you do not use.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="shield" /></div>
          <h3>Compliance Built-In</h3>
          <p>GDPR, UK data residency, and security best practices are part of every engagement, not an expensive add-on.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="settings" /></div>
          <h3>You Own the Result</h3>
          <p>Full documentation, training, and handover. When the engagement ends, your team can run and extend everything independently.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING SUMMARY TABLE -->
  <section class="section bg-grey">
    <div class="container">
      <h2 class="section-title reveal">AI Consulting Services UK Pricing Summary</h2>
      <p class="section-subtitle reveal">All engagements at a glance. Fixed prices, clear deliverables, no surprises.</p>
      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Service</th>
              <th>Starting Price</th>
              <th>Duration</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="col-label">AI Opportunity Audit</td>
              <td>&pound;750-&pound;2,500</td>
              <td>1-2 weeks</td>
              <td>Businesses that need to know where to start</td>
            </tr>
            <tr>
              <td class="col-label"><a href="/services/ai-strategy-uk">AI Strategy UK</a></td>
              <td>&pound;5,000-&pound;15,000</td>
              <td>3-5 weeks</td>
              <td>Businesses ready for a complete adoption roadmap</td>
            </tr>
            <tr>
              <td class="col-label"><a href="/services/ai-implementation-uk">AI Implementation UK</a></td>
              <td>&pound;8,000-&pound;30,000+</td>
              <td>6-12 weeks</td>
              <td>Businesses that know what they want and need it built</td>
            </tr>
            <tr>
              <td class="col-label"><a href="/services/ai-automation-uk">AI Automation UK</a></td>
              <td>&pound;3,000-&pound;15,000</td>
              <td>2-8 weeks</td>
              <td>Businesses that want to automate specific workflows</td>
            </tr>
            <tr>
              <td class="col-label">Fractional CAIO</td>
              <td>&pound;2,000-&pound;5,000/month</td>
              <td>Ongoing</td>
              <td>Businesses that need part-time AI leadership</td>
            </tr>
            <tr>
              <td class="col-label">AI Training Workshops</td>
              <td>from &pound;1,500</td>
              <td>Half or full day</td>
              <td>Teams that need AI literacy and hands-on skills</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- WHAT MAKES OUR PRICING DIFFERENT -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">What Makes Our AI Consulting Services UK Pricing Different</h2>
      <p class="section-subtitle reveal">Three things that set our pricing apart from other AI consultancies in the UK.</p>
      <div class="cards-grid cards-3">
        <div class="card reveal">
          <div class="card-icon"><Icon name="target" /></div>
          <h3>Published Pricing</h3>
          <p>Most AI consultancies refuse to share pricing until they have you on a call. We publish our prices on every page. You know what things cost before you commit any time. <a href="/blog/affordable-ai-consulting-uk-pricing">Read our full pricing guide</a>.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="settings" /></div>
          <h3>Fixed, Not Day-Rate</h3>
          <p>Day-rate billing creates a perverse incentive: the longer it takes, the more the consultant earns. Fixed-price aligns our interests with yours. We are rewarded for efficiency, not for dragging things out.</p>
        </div>
        <div class="card reveal">
          <div class="card-icon"><Icon name="compass" /></div>
          <h3>Stoppable at Any Stage</h3>
          <p>Each engagement is self-contained. Start with the &pound;750 audit and stop there if it is enough. No obligation to continue to strategy or implementation. You are never locked into a long contract.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING FAQ -->
  <section class="section bg-grey" id="pricing-faq">
    <div class="container">
      <h2 class="section-title reveal">Pricing &amp; Engagement FAQs</h2>
      <FAQ items={pricingFaqs} />
    </div>
  </section>

  <!-- FREE TOOLS PROMO -->
  <section class="section bg-grey" id="free-tools">
    <div class="container">
      <h2 class="reveal" style="text-align:center;">Try Our Free AI Tools First</h2>
      <p class="reveal" style="text-align:center;max-width:600px;margin:0 auto 40px;color:var(--grey-600);font-size:1.1rem;">Not sure which service is right for you? Start with a free tool. No email needed to see your results.</p>
      <div class="grid-3">
        <div class="reveal tool-card">
          <div style="font-size:2rem;margin-bottom:12px;">📊</div>
          <h3>AI Readiness Quiz</h3>
          <p>15 questions, 2 minutes. Find out if your business is ready for AI.</p>
          <a href="/assessment" class="btn btn-primary">Start Quiz</a>
        </div>
        <div class="reveal tool-card">
          <div style="font-size:2rem;margin-bottom:12px;">💰</div>
          <h3>AI Cost Savings Calculator</h3>
          <p>Estimate how much AI could save your business each year.</p>
          <a href="/ai-cost-savings-calculator" class="btn btn-primary">Calculate Savings</a>
        </div>
        <div class="reveal tool-card">
          <div style="font-size:2rem;margin-bottom:12px;">🛡️</div>
          <h3>AI Risk Checker</h3>
          <p>Check your AI compliance. Are you GDPR-ready? Get your risk score.</p>
          <a href="/ai-risk-checker" class="btn btn-primary">Check My Risk</a>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Not Sure Which Service You Need?"
    text="That is exactly what the free discovery call is for. We will talk through your situation and recommend the right starting point, even if that is not yet."
    secondaryCtaText="See How It Works"
    secondaryCtaHref="/process"
  />
</BaseLayout>